! =============================================================================
! Synthetic Photometry Lab -- single working inlist (inlist_run)
!
! ./rn copies this file to ./inlist and runs ./star inlist, so this one file
! is the only thing you edit.
!
! Model: 5 Msun, Z = 0.0014, step core overshoot, evolved THROUGH core helium
! burning so the star performs a blue loop across the classical (Cepheid)
! instability strip. &colors is set for GAIA, absolute magnitudes (10 pc),
! Vega system. It runs as-is -- everything in &colors and &controls is meant to
! be changed. That is the whole point of the lab.
! =============================================================================

&star_job
  ! see star/defaults/star_job.defaults

  ! begin with a pre-main sequence model
    create_pre_main_sequence_model = .true.

  ! reduce preMS relaxation steps from 300 to 100 to save computation time
    pre_ms_relax_num_steps = 100

  ! display on-screen plots
    pgstar_flag = .true.

  ! history / profile column selections
    history_columns_file = 'my_history_columns.list'
    profile_columns_file = 'my_profile_columns.list'

  ! save a model at the end of the run
    save_model_when_terminate = .true.
    save_model_filename = '5Msun_Z0.0014_step_fov0.04_blueloop.mod'

  ! grow the first timestep after the convective core forms (0.00001 -> 1 yr)
    set_initial_dt = .true.
    years_for_initial_dt = 1d0

/ ! end of star_job namelist


&eos
  ! eos options -- see eos/defaults/eos.defaults

/ ! end of eos namelist


&kap
  ! kap options -- see kap/defaults/kap.defaults

    use_Type2_opacities = .true.
    Zbase = 0.0014d0

/ ! end of kap namelist


! =============================================================================
! COLORS NAMELIST -- synthetic photometry settings
! Custom colors and this project inlist by Niall Miller
!
! Every path below is interpreted relative to $MESA_DIR. Swap these lines to
! observe the same star with a different instrument, atmosphere grid, or
! magnitude system.
! =============================================================================
&colors
      ! Enable the colors module
      use_colors = .true.

      ! Filter system: a directory of transmission curves.
      ! Available in the prerelease: GAIA, 2MASS, Generic, JWST, TESS
      ! NOTE: the instrument path must NOT end in a slash.
      instrument = '/data/colors_data/filters/GAIA/GAIA'

      ! Stellar atmosphere grid that is interpolated into the SED.
      ! Available: Kurucz2003all, Kurucz2003all__alpha_04, bbody
      ! NOTE: the stellar_atm path MUST end in a slash.
      stellar_atm = '/data/colors_data/stellar_models/Kurucz2003all/'

      ! Reference spectrum that defines the Vega zero point
      vega_sed = '/data/colors_data/stellar_models/vega_flam.csv'

      ! Magnitude system: 'Vega' or 'AB'
      mag_system = 'Vega'

      ! Distance to the star, in cm.
      !   10 pc = 3.0857d19 cm  -> absolute magnitudes
      !   any other distance    -> apparent magnitudes (via the distance modulus)
      distance = 3.0857d19

      ! Write a full SED per filter at every profile interval.
      ! Required for the SED plots and movies in python_analysis/.
      make_csv = .true.

      ! Subdirectory of LOGS/ that the SED csv files are written to (LOGS/SED/...)
      colors_results_directory = 'SED'

/ ! end of colors namelist


&controls
  ! see star/defaults/controls.defaults

  ! starting specifications
    initial_mass = 5d0    ! in Msun units
    initial_z = 0.0014    ! initial metal mass fraction

  ! when to stop
    ! define ZAMS for reporting, but do not stop there
    Lnuc_div_L_zams_limit = 0.99d0
    stop_near_zams = .false.

    ! Evolve THROUGH core helium burning so the star performs its blue loop
    ! across the instability strip, then stop near central He exhaustion.
    ! (Switch the species back to 'h1' at 1d-6 to stop at the TAMS instead.)
    xa_central_lower_limit_species(1) = 'he4'
    xa_central_lower_limit(1) = 1d-4

  ! winds
    hot_wind_scheme = 'Dutch'
    cool_wind_RGB_scheme = 'Dutch'
    Dutch_scaling_factor = 1d0

  ! mixing length
    mixing_length_alpha = 1.8d0

  ! mixing: Ledoux + step core overshoot.
  ! The extent of the blue loop is sensitive to mass, Z, overshoot and mixing,
  ! so these are good knobs to experiment with if the loop is short.
    use_Ledoux_criterion = .true.
    overshoot_scheme(1) = 'step'
    overshoot_zone_type(1) = 'any'
    overshoot_zone_loc(1) = 'core'
    overshoot_bdy_loc(1) = 'top'
    overshoot_f(1) = 0.04d0
    overshoot_f0(1) = 0.01d0

  ! solver / energy conservation (see MESA V, Section 3)
    energy_eqn_option = 'dedt'
    use_gold_tolerances = .true.

  ! output
    history_interval = 1

/ ! end of controls namelist


